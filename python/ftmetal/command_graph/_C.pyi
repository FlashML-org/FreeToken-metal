"""Type stub of the C++ extension built from command_graph/csrc (see bindings.cpp)."""

import mlx.core as mx

Stream = mx.Stream | mx.Device | None

class CallCounts:
    @property
    def dispatches(self) -> int: ...
    @property
    def encoders(self) -> int: ...
    @property
    def barriers(self) -> int: ...
    @property
    def commits(self) -> int: ...
    @property
    def signal_events(self) -> int: ...
    @property
    def completion_handlers(self) -> int: ...
    @property
    def fence_updates(self) -> int: ...
    @property
    def fence_waits(self) -> int: ...

class GraphStats:
    @property
    def num_dispatches(self) -> int: ...
    @property
    def num_encoders(self) -> int: ...
    @property
    def num_barriers(self) -> int: ...
    @property
    def num_bindings(self) -> int: ...
    @property
    def num_bytes_arguments(self) -> int: ...
    @property
    def num_step_input_buffers(self) -> int: ...
    @property
    def num_pool_buffers(self) -> int: ...
    @property
    def num_external_buffers(self) -> int: ...
    @property
    def num_constant_buffers(self) -> int: ...
    @property
    def num_intermediate_buffers(self) -> int: ...
    @property
    def num_temporary_buffers(self) -> int: ...
    @property
    def num_held_arrays(self) -> int: ...
    @property
    def temporaries(self) -> list[tuple[int, int]]: ...
    @property
    def capture_pinned_bytes(self) -> int: ...
    @property
    def pinned_bytes(self) -> int: ...
    @property
    def step_input_bytes(self) -> int: ...
    @property
    def num_pinned_temporaries(self) -> int: ...
    @property
    def arena_bytes(self) -> int: ...
    @property
    def calls(self) -> CallCounts: ...

class Graph:
    @property
    def stats(self) -> GraphStats: ...
    @property
    def dispatch_names(self) -> list[str]: ...
    @property
    def block_sizes(self) -> list[int]: ...
    @property
    def block_labels(self) -> list[str]: ...
    @property
    def temporary_blocks(self) -> list[int]: ...
    @property
    def dispatch_blocks(self) -> list[list[int]]: ...
    @property
    def dispatch_barriers(self) -> list[bool]: ...
    @property
    def dispatch_encoders(self) -> list[int]: ...

def begin_capture(
    outputs: list[mx.array],
    step_inputs: list[mx.array],
    pools: list[mx.array],
    externals: list[mx.array],
) -> None: ...
def end_capture() -> Graph: ...
def abort_capture() -> None: ...
def graph_replay(
    graph: Graph,
    step_inputs: list[mx.array],
    pools: list[mx.array],
    *,
    stream: Stream = None,
) -> list[mx.array]: ...
def compare_graphs(first: Graph, second: Graph) -> list[str]: ...
def poison_blocks(graph: Graph, blocks: list[int]) -> None: ...
def restore_blocks(graph: Graph) -> None: ...
def place_blocks(graph: Graph, offsets: list[int]) -> None: ...
def bind_arena(graph: Graph, arena: mx.array) -> None: ...
